# ─────────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shared_calendar
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# ─────────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CLIENT=predis

# ─────────────────────────────────────────────────
#  FastAPI backend
# ─────────────────────────────────────────────────
# IMPORTANT: change SECRET_KEY for production — minimum 32 chars
SECRET_KEY=change-me-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=http://localhost,http://nginx

# ─────────────────────────────────────────────────
#  Laravel frontend
# ─────────────────────────────────────────────────
APP_NAME="Shared Calendar"
APP_ENV=local
# IMPORTANT: replace with output of: docker compose run --rm frontend php artisan key:generate --show
APP_KEY=base64:c2hhcmVkLWNhbGVuZGFyLWRldi1rZXktMTIzNDU2Nzg=
APP_DEBUG=true
APP_URL=http://localhost

BACKEND_API_BASE_URL=http://backend:8000
BACKEND_API_TIMEOUT=10

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ─────────────────────────────────────────────────
#  Email  (Stage 05 — Mailpit catches all mail in dev)
# ─────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@shared-calendar.local
MAIL_FROM_NAME="${APP_NAME}"
